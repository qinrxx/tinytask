#!/usr/bin/env bash
# tiny-task - a dead simple terminal to-do list
# Stores tasks one per line in ~/.tiny-task.txt as: [ ] text  /  [x] text

set -euo pipefail

FILE="${TINY_TASK_FILE:-$HOME/.tiny-task.txt}"
touch "$FILE"

BOLD=$'\e[1m'; DIM=$'\e[2m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; RESET=$'\e[0m'

usage() {
  cat <<'USAGE'
tiny-task - a dead simple terminal to-do list

Usage:
  task                    list all tasks
  task add <text>         add a task
  task done <n>           mark task n as done
  task undo <n>           mark task n as not done
  task rm <n>             delete task n
  task clear              delete all completed tasks
  task nuke               delete everything
  task help               show this help

Tasks live in ~/.tiny-task.txt (override with $TINY_TASK_FILE).
USAGE
}

list() {
  if [ ! -s "$FILE" ]; then
    echo "${DIM}No tasks. Add one with:  task add \"buy milk\"${RESET}"
    return
  fi
  local n=0 line
  while IFS= read -r line; do
    n=$((n+1))
    case "$line" in
      '[x] '*) printf '%s%3d. [x] %s%s\n' "$DIM$GREEN" "$n" "${line#\[x\] }" "$RESET" ;;
      *)       printf '%s%3d.%s [ ] %s\n'  "$BOLD" "$n" "$RESET" "${line#\[ \] }" ;;
    esac
  done < "$FILE"
  local total done_n
  total=$(wc -l < "$FILE")
  done_n=$(grep -c '^\[x\] ' "$FILE" || true)
  printf '%s     %s/%s done%s\n' "$DIM" "$done_n" "$total" "$RESET"
}

need_num() {
  [ $# -ge 1 ] || { echo "error: need a task number" >&2; exit 1; }
  case "$1" in ''|*[!0-9]*) echo "error: '$1' is not a task number" >&2; exit 1 ;; esac
  local total; total=$(wc -l < "$FILE")
  [ "$1" -ge 1 ] && [ "$1" -le "$total" ] || { echo "error: no task $1" >&2; exit 1; }
}

mark() { # $1 = line no, $2 = new prefix
  need_num "$1"
  sed -i "$1s/^\[[ x]\] /$2/" "$FILE"
  list
}

cmd="${1:-list}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  list|ls|"")   list ;;
  add|a)
    [ $# -gt 0 ] || { echo "error: nothing to add" >&2; exit 1; }
    printf '[ ] %s\n' "$*" >> "$FILE"
    echo "${YELLOW}added:${RESET} $*"
    ;;
  done|d)       mark "${1:-}" '[x] ' ;;
  undo|u)       mark "${1:-}" '[ ] ' ;;
  rm|del)       need_num "${1:-}"; sed -i "${1}d" "$FILE"; list ;;
  clear)        sed -i '/^\[x\] /d' "$FILE"; echo "cleared completed tasks"; list ;;
  nuke)         : > "$FILE"; echo "all tasks deleted" ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $cmd" >&2; echo; usage; exit 1 ;;
esac
